{
    "name": "jbmm/table-record-manager",
    "description": "Local-only Laravel UI for browsing and managing database tables",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jbmm"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.48|^11.0|^12.0"
    },
    "suggest": {
        "laravel/framework": "Required to use this package in a Laravel application."
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jbmm\\TableRecordManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jbmm\\TableRecordManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jbmm\\TableRecordManager\\TableRecordManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
