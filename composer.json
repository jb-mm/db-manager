{
    "name": "jbmm/db-table-manager",
    "description": "Local-only Laravel UI for browsing and managing database tables",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jbmm"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jbmm\\DbTableManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jbmm\\DbTableManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jbmm\\DbTableManager\\DbTableManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
